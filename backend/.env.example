# CyberMedia AI Editorial Copilot — Backend Environment Variables Template
# Copy this file to .env and fill in your values: cp .env.example .env

# MongoDB Connection URI
MONGODB_URI=mongodb://username:password@host:27017/?authSource=admin

# JWT Secret Key (generate a strong random secret in production)
SECRET_KEY=your-secret-key-here-min-32-chars

# Database name
DB_NAME=cybermedia_editorial

# Token expiry in minutes (480 = 8 hours)
TOKEN_EXPIRE_MINUTES=480

# Gemini API Key (optional — users can supply their own in the UI)
GEMINI_API_KEY=
